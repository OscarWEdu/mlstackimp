<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- hk_models är ett eget, självständigt konsolprojekt och ska inte
         kompileras in i webbprojektet (dubbla Main/AssemblyInfo annars). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);hk_models\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
    <!-- Ger webbprojektet tillgång till HKPrediktor (sparade modeller laddas i HKSomnPrediktor.cs) -->
    <ProjectReference Include="hk_models\hk_models.csproj" />
  </ItemGroup>

</Project>
